# Required: your Anthropic API key (set it in Vercel > Project > Settings > Environment Variables)
ANTHROPIC_API_KEY=

# Optional: model to use. Defaults to Claude Haiku 4.5 (fast, cheap, reads images).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: requests allowed per visitor per 10 minutes, per feature (default 8)
RATE_LIMIT_PER_10_MIN=8
